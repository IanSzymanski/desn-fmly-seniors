---
const { name, image, favorite_emoji, github_permalink, github_profile, codepen_profile } = Astro.props;
const slug = name.toLowerCase().replace(/\s+/g, "-");
---

<figure class="card">

  <img src={image} alt={name} loading="lazy" />

  <figcaption class="card-name">
    <a href={`/${slug}`}><span class="card-emoji">{favorite_emoji}</span> {name}</a>
  </figcaption>

  <nav class="card-links">
    <a href={github_permalink} target="_blank" rel="noopener">Portfolio</a>
    <a href={github_profile} target="_blank" rel="noopener">GitHub</a>
    <a href={codepen_profile} target="_blank" rel="noopener">CodePen</a>
  </nav>

</figure>

<style>
  .card {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid var(--light-surface-accent);
    background: var(--gradient-background);
    border-radius: 10px 65px 10px 10px;
    box-shadow: var(--shadow-drop);
  }

  .card:hover {
    transform: translateY(-8px) scale(1.01);
    box-shadow: var(--hover-drop);
    border: 1px solid var(--light-surface-color);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    border-radius: 10px 50px 10px 10px;
  }

  .card-name {
    font-weight: bold;
    font-size: 2rem;
    }
  
    .card-name:hover {
    background: var(--medium-surface-color);
    width: fit-content;
    }

  .card-emoji {
    background: var(--dark-surface-color);
    padding: .5rem;
    border-radius: 0px 0px 20px 0px;;
    position: absolute;
    transform: translate(-14px, -315px);
  }

  .card-links {
    display: flex;
    gap: 0.75rem;
    padding: 1rem;
    margin-top: auto;
  }

  .card-links a {

  }

  .card-links a:hover {
    background: var(--medium-surface-color);
  }
</style>
